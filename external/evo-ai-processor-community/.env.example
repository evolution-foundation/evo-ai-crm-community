API_TITLE="Agent Processor Community"
API_DESCRIPTION="Agent Processor Community for Evo AI"
API_VERSION="1.0.0"
API_URL="http://localhost:8000"

ORGANIZATION_NAME="Evo AI"
ORGANIZATION_URL="https://evoai.evoapicloud.com"

# Database settings
POSTGRES_CONNECTION_STRING="postgresql://postgres:root@localhost:5432/evo_community"

# Fernet encryption key for API keys (shared with evo-ai-core-service)
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=XoQPOBw2FrzjQS11utERG9qO2MsAnXFxlhIns_uUxRk=

# Logging settings
LOG_LEVEL="INFO"
LOG_DIR="logs"

# Redis settings
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD="your-redis-password"
REDIS_SSL=false
REDIS_KEY_PREFIX="a2a:"
REDIS_TTL=3600

# Tool cache settings
TOOLS_CACHE_ENABLED=true
TOOLS_CACHE_TTL=3600

APP_URL="https://yourdomain.com"

# Evo AI CRM API settings (for CRM tools)
# Service token for authenticating with Evo AI CRM API
EVOAI_CRM_API_TOKEN=""
# Base URL for Evo AI CRM API (defaults to http://localhost:3000)
EVO_AI_CRM_URL="http://localhost:3000"

# Server settings
HOST="0.0.0.0"
PORT=8000
DEBUG=false

# ============================================================================
# MEMORY & KNOWLEDGE SERVICES CONFIGURATION
# ============================================================================
# Both memory and knowledge services now use the knowledge microservice via HTTP.
# All Pinecone/Qdrant/OpenSearch configurations have been removed.
# ============================================================================

# Core microservice settings
CORE_SERVICE_URL="http://localhost:9001/api/v1"

# --- CRM-236: agent execution bounds -----------------------------------------
# Cancel the agent run when the caller (bot-runtime) hangs up. On by default:
# without it a run outlived its caller by minutes, burning the same provider
# quota whose exhaustion caused the timeout. Set to false to restore the old
# behaviour.
A2A_CANCEL_ON_DISCONNECT=true

# Fallback polling interval (seconds) used only when the request object exposes
# no ASGI receive channel. The normal path is event-driven and does not poll.
# Floored at 0.1 so a typo cannot busy-loop the event loop.
A2A_DISCONNECT_POLL_SECONDS=1.0
